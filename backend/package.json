{
  "name": "restaurant-system-backend",
  "version": "1.0.0",
  "description": "Express REST API for Restaurant Management System with Sequelize, PostgreSQL, Zod, and Multer",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seeds/seed.js",
    "db:reset": "node src/seeds/reset.js",
    "seed:reset": "node src/seeds/reset.js",
    "admin:promote": "node src/scripts/manageAdmin.js promote",
    "admin:create": "node src/scripts/manageAdmin.js create",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
