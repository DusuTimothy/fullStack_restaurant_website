PORT=
NODE_ENV=
CLIENT_ORIGIN=

# Database Configuration
# Dialect: 'postgres' (default) or 'sqlite'
DB_DIALECT=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=


# File Upload Settings
UPLOAD_DIR=
MAX_FILE_SIZE_MB=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Development Database Seeding
# Required for seeding sample customer/staff accounts during local development.
# Never configure or use this in production.
SEED_USER_PASSWORD=

# Operator Admin Management CLI (Optional / Non-interactive CI only)
# Can be set in environment instead of entering at the secure interactive prompt.
# ADMIN_PASSWORD=
# ADMIN_CONFIRM=yes

